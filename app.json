{
  "expo": {
    "name": "ArenaS",
    "slug": "arenas-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "arenas",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "jsEngine": "hermes",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.arenas.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/Img/logo.JPG.jpg",
        "backgroundColor": "#007F3F"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "88643c8f-7a3f-4aac-97b7-2388531c7ced"
      }
    }
  }
}
